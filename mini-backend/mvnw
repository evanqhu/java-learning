#!/bin/sh
set -eu

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MAVEN_VERSION=3.9.11
MAVEN_HOME="$BASE_DIR/.mvn/apache-maven-$MAVEN_VERSION"
ARCHIVE_URL="https://archive.apache.org/dist/maven/maven-3/$MAVEN_VERSION/binaries/apache-maven-$MAVEN_VERSION-bin.tar.gz"

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  echo "Preparing Apache Maven $MAVEN_VERSION for this project..."
  mkdir -p "$BASE_DIR/.mvn"
  TEMP_DIR=$(mktemp -d "${TMPDIR:-/tmp}/java-learning-maven.XXXXXX")
  trap 'rm -rf "$TEMP_DIR"' EXIT INT TERM
  if command -v curl >/dev/null 2>&1; then
    curl --fail --location --silent --show-error "$ARCHIVE_URL" --output "$TEMP_DIR/maven.tar.gz"
  elif command -v wget >/dev/null 2>&1; then
    wget --quiet "$ARCHIVE_URL" --output-document="$TEMP_DIR/maven.tar.gz"
  else
    echo "curl or wget is required to download Maven." >&2
    exit 1
  fi
  tar -xzf "$TEMP_DIR/maven.tar.gz" -C "$BASE_DIR/.mvn"
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
